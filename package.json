{
  "name": "mindlog",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:api": "pnpm --filter mindlog-api dev",
    "dev:mobile": "pnpm --filter mindlog-mobile start",
    "build:api": "pnpm --filter mindlog-api build",
    "build:types": "pnpm --filter @mindlog/types build",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rimraf node_modules dist .expo"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}