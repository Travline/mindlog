# IP accesible desde el teléfono en la misma red
EXPO_PUBLIC_DEV_API_URL=http://192.168.1.100:8080
# URL HTTPS de la API desplegada en Vercel
EXPO_PUBLIC_PROD_API_URL=https://your-api.vercel.app
# Solo si el proyecto EAS no tiene extra.eas.projectId en app.json
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
# Archivo descargado de Firebase para builds Android locales; no subirlo al repositorio
# GOOGLE_SERVICES_JSON=./google-services.json
