{
  "expo": {
    "name": "Mindlog",
    "slug": "mindlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mindlog",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "cameraPermission": "Mindlog usa la cámara para escanear invitaciones a tableros."
        }
      ]
    ],
    "android": {
      "package": "com.mindlog.app"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "13bf300b-c80f-47f8-bda0-7aa1d385ca88"
      }
    }
  }
}
