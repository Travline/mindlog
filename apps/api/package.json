{
  "name": "mindlog-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env build/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "express": "5.2.1",
    "jose": "^6.2.17",
    "pino": "10.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-dist": "^5.35.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^22.20.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
